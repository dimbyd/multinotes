\def\multinotes@remove{\afterassignment\checkit\let\char=}%
\def\checkit{%
    \ifcat\char\null %
        \let\char=\null%
    \fi%
    \ifcat\char\space%
        \let\next=\multinotes@remove%
    \else%
        \ifcat\char x%
            \let\next=\multinotes@remove%
        \else%
            \ifcat\char 1%
                \let\next=\multinotes@remove%
            \else%
            \noexpand\char
                \let\next=\relax%
            \fi%
        \fi%
    \fi%
    \next%
 }%
